{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xrcopilotlab.hevolus.it/schemas/blueprint.v1.schema.json",
  "title": "XRCopilotLab Blueprint manifest v1",
  "description": "Descrizione dichiarativa di tutto ciò che un blueprint crea su un tenant XRCopilotLab. I nomi si scrivono senza prefisso: il planner antepone BP-<TAG>-. I segreti non compaiono mai come valore, solo come nome di una chiave di App Configuration.",
  "type": "object",
  "required": [
    "blueprint",
    "tag",
    "tenant"
  ],
  "additionalProperties": false,
  "properties": {
    "blueprint": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificativo logico del blueprint, stabile fra le versioni."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,20}$",
      "description": "Contesto o cliente: entra nel prefisso di ogni entità creata."
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ],
      "description": "RISERVATO: accettato ma non ancora applicato."
    },
    "tenant": {
      "type": "object",
      "required": [
        "companyId"
      ],
      "additionalProperties": false,
      "properties": {
        "companyId": {
          "type": "string",
          "description": "GUID del tenant di destinazione."
        },
        "topic": {
          "type": "string",
          "description": "Nome del topic da CREARE (senza prefisso: lo aggiunge il planner)."
        },
        "description": {
          "type": "string",
          "description": "Descrizione del topic da CREARE. Ignorata quando si riusa un topic esistente."
        },
        "topicId": {
          "type": "string",
          "description": "Id di un topic già esistente, quando il nome è ambiguo. Alternativa a existingTopic."
        },
        "existingTopic": {
          "type": "string",
          "description": "Nome di un topic GIÀ ESISTENTE in cui mettere gli agenti, come compare nella UI. Non viene creato né modificato, e il rollback non lo tocca."
        }
      },
      "oneOf": [
        {
          "required": [
            "topic"
          ]
        },
        {
          "required": [
            "existingTopic"
          ]
        },
        {
          "required": [
            "topicId"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "topic"
                ]
              },
              {
                "required": [
                  "existingTopic"
                ]
              },
              {
                "required": [
                  "topicId"
                ]
              }
            ]
          }
        }
      ]
    },
    "connections": {
      "type": "array",
      "description": "Connessioni verso sistemi di terze parti. Verificate ma non ancora create (milestone 2).",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "provider"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "examples": [
              "webhook"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "process": {
            "type": "string",
            "description": "Chiave di un processo di questo blueprint: la connessione punta al suo webhook di avvio. Indirizzo e chiave li mette l'apply (la chiave finisce in Key Vault come Blueprints:Secrets:<TAG>:webhook-<chiave>). Esclude baseUrl e auth."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "auth": {
            "$ref": "#/$defs/auth"
          }
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "description": "Server MCP: costruiti con l'MCP Builder (builder), registrati nel catalogo (external), oppure già nel catalogo del tenant e soltanto collegati agli agenti (existing).",
      "items": {
        "type": "object",
        "required": [
          "key",
          "kind",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "builder",
              "external",
              "existing"
            ]
          },
          "name": {
            "type": "string",
            "description": "Nome senza prefisso. Per kind=existing è il nome esatto nel catalogo del tenant, e il prefisso BP-<TAG>- non si aggiunge."
          },
          "mcpId": {
            "type": "string",
            "description": "kind=existing: id del server nel catalogo del tenant. Serve solo se più server hanno lo stesso nome; se c'è, vince sul nome."
          },
          "description": {
            "type": "string"
          },
          "systemPrompt": {
            "type": "string"
          },
          "promptMode": {
            "enum": ["append", "replace", "skip"],
            "description": "Cosa fare del prompt suggerito sull'agente che usa il server: append (default) lo mette in coda al system message, replace lo sostituisce, skip lo lascia solo sul server."
          },
          "connection": {
            "type": "string",
            "description": "kind=builder: chiave della connessione usata dai tool."
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "method",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object",
                  "description": "Parametri del tool. Il valore è la descrizione ('nome: a cosa serve'), oppure un oggetto con type/description/enum quando serve il controllo pieno. La descrizione è ciò che il modello legge per decidere come chiamare il tool.",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": {
                            "enum": [
                              "string",
                              "number",
                              "integer",
                              "boolean",
                              "array",
                              "object"
                            ]
                          },
                          "description": {
                            "type": "string"
                          },
                          "enum": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "required": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "body": {
                  "type": "string"
                },
                "transform": {
                  "type": "string",
                  "description": "Funzione JavaScript che trasforma la risposta."
                },
                "query": {
                  "type": "object",
                  "description": "Parametri di query, con i placeholder {{nome}}.",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "headers": {
                  "type": "object",
                  "description": "Header specifici di questo tool, oltre a quelli della connessione.",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "responseFormat": {
                  "enum": ["json", "xml", "text"],
                  "description": "Come leggere la risposta. 'text' per le chiamate che rispondono senza corpo (sendMail, reply): un 202 vuoto non è un JSON."
                },
                "contentType": {
                  "type": "string",
                  "description": "Content-type del corpo. Default application/json; per SOAP text/xml."
                }
              }
            }
          },
          "testTool": {
            "type": "string"
          },
          "publish": {
            "type": "boolean",
            "default": true
          },
          "url": {
            "type": "string",
            "description": "kind=external: URL del server già ospitato."
          },
          "auth": {
            "$ref": "#/$defs/auth"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "testArguments": {
            "type": "object",
            "description": "Argomenti con cui esercitare testTool. Senza, il test non si esegue."
          }
        }
      }
    },
    "businessRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            },
            "description": "Utenti già esistenti nel tenant: il blueprint li aggiunge al ruolo, non li crea."
          }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "description": "Profili di knowledge creati nel topic: i RAG che gli agenti interrogano.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Nome del profilo, senza prefisso."
          },
          "description": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "examples": [
              "it",
              "en"
            ]
          },
          "knowledgeGraph": {
            "type": "boolean",
            "description": "Assente = true. Si scrive false solo per chiedere l'indice di ricerca classico."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Percorso relativo alla cartella del manifest. Il push lo archivia con la versione."
                },
                "name": {
                  "type": "string",
                  "description": "Nome nel topic. Se assente vale il nome del file."
                },
                "fileType": {
                  "enum": [
                    "original",
                    "reference",
                    "target",
                    "template"
                  ],
                  "description": "Da lasciare vuoto (= original) salvo richiesta esplicita."
                }
              }
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "base",
              "smart"
            ],
            "description": "Tipo di agente. Assente significa smart (Q&A), il default sia della UI che del provisioning esistente."
          },
          "systemMessage": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "Modello del suo endpoint di chat implicito, quando chatEndpoints è assente o vuoto."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Deprecato: sostituito da verbosityLevel, ignorato a runtime dal 2026-04. Mantenuto per compatibilità con manifest più vecchi."
          },
          "language": {
            "type": "string",
            "examples": [
              "it",
              "en"
            ],
            "description": "Lingua dell'agente, e del suo endpoint di chat implicito quando chatEndpoints è assente o vuoto."
          },
          "verbosityLevel": {
            "type": "string",
            "enum": [
              "veryConcise",
              "concise",
              "verbose",
              "noLimit"
            ],
            "description": "Controlla la lunghezza della risposta. Assente significa concise."
          },
          "minRankingScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "minWordsValidation": {
            "type": "integer",
            "minimum": 0
          },
          "searchTopK": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Chunk RAG recuperati per profilo. Assente = default (3)."
          },
          "reasoningEffort": {
            "type": "string",
            "enum": [
              "minimal",
              "low",
              "medium",
              "high"
            ],
            "description": "Solo sui modelli che lo supportano. Assente = decide il modello."
          },
          "disableHistory": {
            "type": "boolean"
          },
          "enableGroundednessDetection": {
            "type": "boolean"
          },
          "enablePermanentMemory": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string",
            "description": "Nome di un endpoint AI della company a cui collegare l'agente, come compare nella configurazione del tenant. Serve quando la company ne ha uno proprio (tipicamente Anthropic): senza, l'agente parla con gli endpoint condivisi qualunque modello dichiari. Deve esistere gia: il blueprint lo collega, non lo crea."
          },
          "chatEndpoints": {
            "type": "array",
            "description": "Endpoint di chat dell'agente (non va confuso con endpoint, l'endpoint AI del tenant). Assente o vuoto significa un endpoint implicito, costruito da model e language. Con uno o più elementi, se ne crea uno per ciascuno — sempre inattivi.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string"
                },
                "language": {
                  "type": "string",
                  "examples": [
                    "it",
                    "en"
                  ]
                },
                "welcomeMessage": {
                  "type": "string"
                },
                "enableSuggestions": {
                  "type": "boolean"
                },
                "suggestionMode": {
                  "type": "string",
                  "enum": [
                    "automatic",
                    "manual",
                    "manualAutomatic"
                  ]
                },
                "manualSuggestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 6
                }
              }
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "SkillId già presenti nel catalogo del tenant."
          },
          "mcp": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Chiavi di mcpServers."
          },
          "knowledge": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Chiavi di knowledge[]: i profili che l'agente interroga."
          },
          "files": {
            "type": "array",
            "description": "File collegati direttamente all'agente, per le skill che li leggono (spreadsheet). Il tipo di default è reference.",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Percorso relativo alla cartella del manifest. Il push lo archivia con la versione."
                },
                "name": {
                  "type": "string",
                  "description": "Nome nel topic. Se assente vale il nome del file. Un nome ha un solo tipo nel topic."
                },
                "fileType": {
                  "enum": [
                    "original",
                    "reference",
                    "target",
                    "template"
                  ],
                  "description": "Assente = reference: è il tipo che la skill spreadsheet legge."
                }
              }
            }
          }
        }
      }
    },
    "agentTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "description": "Chiave di un agente. In alternativa a orchestrator."
          },
          "orchestrator": {
            "type": "string",
            "description": "Chiave di un orchestratore. In alternativa ad agent."
          },
          "prompt": {
            "type": "string"
          },
          "trigger": {
            "enum": [
              "manual",
              "scheduled",
              "webhook"
            ],
            "description": "Come parte il task. Default manual."
          },
          "schedule": {
            "type": "object",
            "description": "Obbligatoria con trigger: scheduled.",
            "required": [
              "cron"
            ],
            "additionalProperties": false,
            "properties": {
              "cron": {
                "type": "string",
                "description": "Espressione cron a cinque campi, es. '*/5 * * * *'."
              },
              "timeZone": {
                "type": "string",
                "description": "Fuso IANA, es. Europe/Rome. Default UTC."
              }
            }
          },
          "executionPolicy": {
            "type": "object",
            "description": "Limiti di esecuzione del task. Senza, i default della piattaforma: 100 esecuzioni al giorno, 300 secondi, nessun tentativo in più.",
            "additionalProperties": false,
            "properties": {
              "maxDailyExecutions": {
                "type": "integer",
                "minimum": 1,
                "description": "Esecuzioni ammesse in un giorno (UTC). Un task schedulato ogni minuto ne fa 1440."
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "description": "Tempo massimo di una singola esecuzione."
              },
              "maxRetries": {
                "type": "integer",
                "minimum": 0,
                "description": "Tentativi in più dopo un fallimento."
              }
            }
          },
          "outputActions": {
            "type": "array",
            "description": "Destinazioni aggiuntive del risultato. La casella in-app riceve sempre l'esito e non va dichiarata.",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "email",
                    "webhook"
                  ]
                },
                "recipients": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "subject": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "URL assoluto, oppure 'processes.<chiave>.webhook' per avviare un processo di questo stesso blueprint: indirizzo e chiave li mette il planner."
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "body": {
                  "type": "object",
                  "description": "Forma del corpo della POST. I valori accettano {{agentResponse}}, {{taskName}}, {{status}}, {{executionId}}, {{timestamp}}. Verso il webhook di un processo le chiavi diventano le variabili del caso: devono chiamarsi come i campi del modulo di avvio."
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "agent"
            ]
          },
          {
            "required": [
              "orchestrator"
            ]
          }
        ]
      }
    },
    "orchestrators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "welcomeMessage": {
            "type": "string",
            "description": "Messaggio mostrato all'apertura della chat dell'orchestratore, prima che l'utente scriva (max 1500 caratteri)."
          },
          "language": {
            "type": "string",
            "description": "Lingua dell'endpoint di chat (it, en…); default it."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "name",
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Citata dai flussi."
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "start",
                    "agent",
                    "condition",
                    "switch",
                    "parallelGroup",
                    "handoffGroup",
                    "userQuestion",
                    "humanApproval",
                    "sendMessage",
                    "action",
                    "terminate"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "displayOutput": {
                  "type": "boolean"
                },
                "agent": {
                  "type": "string",
                  "description": "type: agent — chiave dell'agente eseguito."
                },
                "userMessageTemplate": {
                  "type": "string",
                  "description": "type: agent — con i placeholder {{variabile}}."
                },
                "requireStructuredOutput": {
                  "type": "boolean",
                  "description": "type: agent — pretende una risposta conforme a outputSchema."
                },
                "outputSchema": {
                  "type": "object",
                  "description": "type: agent — schema JSON della risposta attesa."
                },
                "skillMetadata": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "type: agent — parametri passati alla skill dello step, non all'agente."
                },
                "allowAgentInteraction": {
                  "type": "boolean",
                  "description": "type: agent — default true."
                },
                "allowFileUploadOnPause": {
                  "type": "boolean",
                  "description": "type: agent — default false."
                },
                "useTempFiles": {
                  "type": "boolean",
                  "description": "type: agent — default true."
                },
                "maxLoopIterations": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "type: agent — quante volte può rieseguire in un ciclo."
                },
                "loopInstruction": {
                  "type": "string",
                  "description": "type: agent — istruzione aggiunta al prompt nelle riesecuzioni."
                },
                "condition": {
                  "type": "object",
                  "description": "type: condition — ha due rami, true e false, entrambi obbligatori."
                },
                "switchVariable": {
                  "type": "string",
                  "description": "type: switch — variabile confrontata con i casi."
                },
                "cases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "type: switch — ogni caso vuole un flusso con la propria label."
                },
                "defaultCase": {
                  "type": "string",
                  "description": "type: switch — se dichiarato, vuole anch'esso il proprio flusso."
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "type: parallelGroup | handoffGroup — chiavi degli agenti del gruppo."
                },
                "agentOutputs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "type: parallelGroup | handoffGroup — chiave agente → variabile di contesto."
                },
                "maxParallel": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "type: parallelGroup — quanti girano insieme. Default 5."
                },
                "question": {
                  "type": "string",
                  "description": "type: userQuestion."
                },
                "contextVariable": {
                  "type": "string",
                  "description": "type: userQuestion | humanApproval — dove finisce la risposta."
                },
                "ctas": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "type: userQuestion — risposte rapide."
                },
                "allowFileUpload": {
                  "type": "boolean",
                  "description": "type: userQuestion."
                },
                "title": {
                  "type": "string",
                  "description": "type: humanApproval."
                },
                "recipients": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "email"
                  },
                  "description": "type: humanApproval — devono essere utenti del tenant."
                },
                "timeoutHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168,
                  "description": "type: humanApproval — default 72."
                },
                "text": {
                  "type": "string",
                  "description": "type: sendMessage."
                },
                "provider": {
                  "enum": [
                    "email",
                    "webhook",
                    "javascript"
                  ],
                  "description": "type: action."
                },
                "action": {
                  "type": "string",
                  "description": "type: action — es. 'send' per il provider email."
                },
                "connection": {
                  "type": "string",
                  "description": "type: action — chiave della connessione, quando il provider la richiede."
                },
                "input": {
                  "type": "object",
                  "description": "type: action — ingresso, nella forma dichiarata dal provider."
                },
                "inputMapping": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "type: agent — variabili che il passo legge. Il motore la pretende quando c'è userMessageTemplate."
                },
                "outputMapping": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "type: agent — dove finisce la risposta: la CHIAVE è la variabile che i passi a valle citano con {{variabile}}. Senza, il risultato non entra nel contesto e la catena si passa il testo della chat."
                }
              }
            }
          },
          "flows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "condition": {
                  "type": "boolean",
                  "description": "Ramo di uno step condition: true o false. Entrambi obbligatori."
                },
                "label": {
                  "type": "string",
                  "description": "Caso di uno switch, oppure 'approved'/'rejected' per humanApproval."
                }
              }
            },
            "description": "Archi fra gli step. Si chiamano flows e non connections: connections, nel manifest, sono le connessioni verso i sistemi di terze parti."
          }
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Se assente si usa spec.name."
          },
          "description": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/$defs/processSpec"
          },
          "bpmnFile": {
            "type": "string",
            "description": "Percorso di un .bpmn, relativo al manifest. Alternativo a spec."
          },
          "publish": {
            "type": "boolean",
            "default": true
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "starterRoles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Chiavi di businessRoles."
          },
          "webhook": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "allowedIps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "spec"
            ]
          },
          {
            "required": [
              "bpmnFile"
            ]
          }
        ]
      }
    },
    "external": {
      "type": "object",
      "description": "Risorse fuori dalla piattaforma. Verificate ma non ancora create (milestone 2).",
      "additionalProperties": false,
      "properties": {
        "mailbox": {
          "type": "string",
          "format": "email"
        },
        "auth": {
          "enum": [
            "interactive",
            "appRegistration"
          ]
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "logicapp",
                "scheduledAgentTask"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^processes\\.[A-Za-z0-9_-]+\\.webhook$"
            },
            "pollMinutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "logicapp"
              ]
            },
            "exposeAs": {
              "type": "string"
            },
            "calendarUser": {
              "type": "string"
            }
          }
        },
        "manualSteps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourceGroup": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "auth": {
      "type": "object",
      "description": "I campi che portano una credenziale contengono il NOME di una chiave App Configuration (Blueprints:Secrets:<TAG>:<nome>), mai il valore.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "None",
            "Bearer",
            "Basic",
            "CustomHeaders",
            "OAuth2ClientCredentials"
          ]
        },
        "tokenUrl": {
          "type": "string",
          "format": "uri"
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "processSpec": {
      "type": "object",
      "description": "Identica alla ProcessSpec accettata da POST processes/{companyId}/generate. I riferimenti per nome (roleName, agentTaskName, calledProcessName) si scrivono SENZA prefisso: li qualifica il planner.",
      "required": [
        "version",
        "name",
        "activities",
        "flows"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "categoryName": {
          "type": "string",
          "description": "Categoria del catalogo del tenant: NON viene prefissata."
        },
        "criticality": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "dataSensitivity": {
          "enum": [
            "Public",
            "Internal",
            "Confidential",
            "Regulated"
          ]
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "type": {
                "enum": [
                  "Start",
                  "End",
                  "Task",
                  "CallActivity"
                ]
              },
              "name": {
                "type": "string"
              },
              "performer": {
                "enum": [
                  "HumanOnly",
                  "AiAssisted",
                  "Automated"
                ]
              },
              "roleName": {
                "type": "string"
              },
              "assignmentExpression": {
                "type": "string"
              },
              "agentTaskName": {
                "type": "string"
              },
              "outputVariable": {
                "type": "string"
              },
              "interactive": {
                "type": "boolean"
              },
              "taskCategoryName": {
                "type": "string"
              },
              "expectedDurationMinutes": {
                "type": "integer",
                "minimum": 0
              },
              "maxLeadTimeMinutes": {
                "type": "integer",
                "minimum": 0
              },
              "form": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/formField"
                }
              },
              "calledProcessName": {
                "type": "string"
              },
              "inputMapping": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "outputMapping": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "gateways": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "type": {
                "enum": [
                  "Exclusive",
                  "Parallel"
                ]
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "condition": {
                "type": "object",
                "required": [
                  "var",
                  "op"
                ],
                "additionalProperties": false,
                "properties": {
                  "var": {
                    "type": "string"
                  },
                  "op": {
                    "enum": [
                      "eq",
                      "neq",
                      "gt",
                      "lt",
                      "gte",
                      "lte",
                      "exists"
                    ]
                  },
                  "value": {
                    "description": "Numero, booleano o stringa: il tipo YAML è preservato."
                  }
                }
              }
            }
          }
        }
      }
    },
    "formField": {
      "type": "object",
      "required": [
        "key",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "bool",
            "date",
            "select",
            "user"
          ]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "context": {
          "type": "boolean",
          "description": "Campo di sola lettura alimentato da una variabile a monte."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionsTargetName": {
          "type": "string"
        }
      }
    }
  }
}
