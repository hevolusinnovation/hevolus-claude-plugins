{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "msteams": { "width": "Full" },
  "body": [
    {
      "type": "Container",
      "style": "accent",
      "bleed": true,
      "items": [
        { "type": "TextBlock", "text": "Blueprint: nuove versioni delle skill — dalla {{DA}} alla {{A}}", "weight": "Bolder", "size": "Large", "wrap": true },
        { "type": "TextBlock", "text": "{{APERTURA}}", "wrap": true, "spacing": "Small" }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "Come si aggiorna", "weight": "Bolder", "size": "Medium" },
        { "type": "TextBlock", "text": "**Da terminale — Claude Code**, nella casella dei messaggi, poi riavvia la sessione:", "wrap": true },
        { "type": "TextBlock", "text": "/plugin marketplace update hevolus\n\n/plugin update blueprints@hevolus", "fontType": "Monospace", "wrap": true },
        { "type": "TextBlock", "text": "Solo la CLI, da una shell: `xrcopilotlab-bp update` (con `--check` dice cosa farebbe).", "wrap": true, "spacing": "Small" },
        { "type": "TextBlock", "text": "**Da Claude Desktop**: scarica gli zip `xrcopilotlab-….zip` dalla [pagina delle release](https://github.com/hevolusinnovation/hevolus-claude-plugins/releases/latest) e ricaricali in *Impostazioni → Capacità → Skill*. Da Desktop si scrive, non si applica niente al tenant.", "wrap": true },
        { "type": "TextBlock", "text": "{{AVVERTENZA}}", "wrap": true, "isSubtle": true, "spacing": "Small" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Le novità, versione per versione",
      "weight": "Bolder",
      "size": "Medium",
      "spacing": "Large"
    },
    {
      "type": "Container",
      "separator": true,
      "items": [
        { "type": "TextBlock", "text": "**{{VERSIONE}}** — {{TITOLO}}", "wrap": true },
        { "type": "TextBlock", "text": "{{DATA}} · {{ETICHETTA}}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true },
        { "type": "TextBlock", "text": "{{TESTO}}", "wrap": true, "spacing": "Small" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Gli ultimi blueprint pubblicati in produzione",
      "weight": "Bolder",
      "size": "Medium",
      "spacing": "Large"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "{{BLUEPRINT}} v{{VERSIONE_BP}}", "value": "{{DATA_BP}} · {{DESCRIZIONE_BP}}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Tutte le feature, in una riga",
      "weight": "Bolder",
      "size": "Medium",
      "spacing": "Large"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "{{FEATURE}}", "value": "{{COSA_FA}} — da {{DA_VERSIONE}} · {{SKILL_O_COMANDO}}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Tutte le informazioni sui blueprint — schede, guide, processi, video — sono sul [Blueprint Marketplace](https://yellow-river-0ad4d3203.6.azurestaticapps.net/).",
      "wrap": true,
      "spacing": "Large"
    }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "Blueprint Marketplace", "url": "https://yellow-river-0ad4d3203.6.azurestaticapps.net/" },
    { "type": "Action.OpenUrl", "title": "Guida: dall'intervista alla demo", "url": "{{LINK_GUIDA}}" }
  ]
}
