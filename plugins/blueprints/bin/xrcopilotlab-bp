#!/usr/bin/env bash
# Avvia xrcopilotlab-bp, procurandoselo al primo uso.
#
# Il binario autonomo pesa una cinquantina di megabyte: tenerlo dentro il repository del
# marketplace vorrebbe dire farlo scaricare a tutto il team anche solo per leggere la skill.
# Sta quindi fra gli allegati di una release, e questo script lo mette in cache la prima volta.
#
# L'ordine in cui lo cerca — variabile d'ambiente, strumento globale, cache, download — serve a
# non intralciare chi sviluppa: chi ha già la CLI installata continua a usare la sua.

set -euo pipefail

# Due repository, in quest'ordine. Il binario nasce da una release del repository di prodotto e
# viene rispecchiato su questo catalogo: chi usa i blueprint ha accesso al catalogo — gli è servito
# per installare il plugin — ma quasi mai al prodotto, e quando mancava vedeva un 404 che sembrava
# dire «la release non esiste» invece di «non hai accesso». Il prodotto resta come riserva, per il
# caso in cui una release non sia ancora stata rispecchiata.
REPO_CATALOGO="hevolusinnovation/hevolus-claude-plugins"
REPO_PRODOTTO="hevolusinnovation/xrcopilotlab-webapp-dotnet"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(cat "$HERE/version.txt")"
CACHE_DIR="${CLAUDE_PLUGIN_DATA:-$HOME/.xrcopilotlab-bp/cache}/bin"

die() { echo "xrcopilotlab-bp: $*" >&2; exit 70; }

# La versione del plugin installato, dal suo manifest. Serve all'avviso sulle skill: la CLI ha un
# numero suo (version.txt), ma una versione del plugin può portare skill nuove con la stessa CLI.
PLUGIN_VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9.]*\)".*/\1/p' \
  "$HERE/../.claude-plugin/plugin.json" 2>/dev/null | head -1)"
DATI="${CLAUDE_PLUGIN_DATA:-$HOME/.xrcopilotlab-bp/cache}"
NOTA="$DATI/ultima-cli"
NOTA_PLUGIN="$DATI/ultimo-plugin"

# 1. Un percorso imposto a mano vince su tutto: serve a provare una build locale.
if [ -n "${XRCOPILOTLAB_BP_BIN:-}" ] && [ "${1:-}" != "--avviso-sessione" ]; then
  exec "$XRCOPILOTLAB_BP_BIN" "$@"
fi

# Vero se la prima versione è almeno pari alla seconda. Confronto numerico campo per campo:
# «2.11.2» e «2.9.0» vanno confrontati come numeri, non come stringhe, dove il secondo vincerebbe.
aggiornato() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".");
    n = (na > nb ? na : nb);
    for (i = 1; i <= n; i++) {
      xa = (i <= na ? x[i] + 0 : 0); yb = (i <= nb ? y[i] + 0 : 0);
      if (xa > yb) exit 0;
      if (xa < yb) exit 1;
    }
    exit 0
  }'
}

# Aggiorna le due note — ultima CLI e ultimo plugin pubblicati — leggendo il catalogo. Una chiamata
# a GitHub per ciascuna, al massimo una volta al giorno; se gh non c'è, non sei autenticato o GitHub
# non risponde, le note restano come sono e nessuno se ne accorge.
aggiorna_note() {
  mkdir -p "$DATI" 2>/dev/null || return 0
  gh release list --repo "$REPO_CATALOGO" --limit 30 2>/dev/null \
    | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^bp-v[0-9]/) { sub(/^bp-v/, "", $i); print $i; break } }' \
    | sort -t. -k1,1n -k2,2n -k3,3n | tail -1 > "$NOTA.tmp" 2>/dev/null \
    && [ -s "$NOTA.tmp" ] && mv "$NOTA.tmp" "$NOTA" 2>/dev/null
  # Le note dell'ultima release del catalogo portano la tabella «Versioni»: la riga del plugin
  # blueprints dice quale versione è stata pubblicata per ultima.
  gh release view --repo "$REPO_CATALOGO" --json body --jq .body 2>/dev/null \
    | awk -F'|' '$2 ~ /^[[:space:]]*blueprints[[:space:]]*$/ { gsub(/[[:space:]]/, "", $4); print $4; exit }' \
    > "$NOTA_PLUGIN.tmp" 2>/dev/null \
    && [ -s "$NOTA_PLUGIN.tmp" ] && mv "$NOTA_PLUGIN.tmp" "$NOTA_PLUGIN" 2>/dev/null
  rm -f "$NOTA.tmp" "$NOTA_PLUGIN.tmp" 2>/dev/null
  return 0
}

note_scadute() { [ -z "$(find "$NOTA_PLUGIN" -mtime -1 2>/dev/null)" ]; }

# La riga da dire, o niente. Una sola: se il plugin è indietro, aggiornarlo porta anche la CLI, e
# due righe che dicono la stessa cosa in due modi si smettono di leggere.
messaggio_aggiornamento() {
  if [ -s "$NOTA_PLUGIN" ] && [ -n "$PLUGIN_VERSION" ]; then
    ULTIMO="$(tr -d '\r\n' < "$NOTA_PLUGIN")"
    if [ -n "$ULTIMO" ] && ! aggiornato "$PLUGIN_VERSION" "$ULTIMO"; then
      echo "c'è il plugin blueprints $ULTIMO, questo è il $PLUGIN_VERSION: skill o CLI nuove. Aggiornalo con '/plugin marketplace update hevolus' e '/plugin update blueprints@hevolus', poi riavvia la sessione."
      return 0
    fi
  fi
  if [ -s "$NOTA" ]; then
    ULTIMA="$(tr -d '\r\n' < "$NOTA")"
    if [ -n "$ULTIMA" ] && ! aggiornato "$VERSION" "$ULTIMA"; then
      echo "c'è la $ULTIMA, il plugin chiede la $VERSION. Aggiornalo con '/plugin update blueprints@hevolus'."
    fi
  fi
}

# All'apertura di una sessione di Claude Code (hook SessionStart del plugin): si dice se il plugin è
# indietro, e basta — niente binario da cercare o scaricare, niente comando da eseguire. Qui le note
# si aggiornano in primo piano quando sono scadute: il processo dell'hook finisce subito, e un lavoro
# lasciato in background potrebbe morire con lui. Succede una volta al giorno, e dura un paio di
# secondi.
if [ "${1:-}" = "--avviso-sessione" ]; then
  if command -v gh >/dev/null 2>&1 && note_scadute; then
    aggiorna_note
  fi
  M="$(messaggio_aggiornamento)"
  if [ -n "$M" ]; then
    # La riga all'utente (systemMessage) e a Claude (additionalContext), che le skill istruiscono a
    # ripeterla a parole. Il testo non contiene doppi apici né barre rovesciate: sta in JSON così.
    printf '{"systemMessage":"xrcopilotlab-bp: %s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Il plugin blueprints è indietro. Dillo all\047utente in una riga, con i comandi: %s"}}\n' "$M" "$M"
  fi
  exit 0
fi

# 2. Lo strumento globale .NET, per chi sviluppa anche sul repository — ma solo se non è più
#    vecchio della versione che il plugin si aspetta.
#
#    Prima veniva usato in ogni caso, ed è la trappola che costava di più: chi aveva installato la
#    CLI a mano mesi prima continuava a usare quella anche dopo un aggiornamento del plugin, con le
#    skill che nominavano comandi che quel binario non ha. Nessuno dei due lo segnalava.
#    Chi vuole imporre la propria build ha la strada di sopra: XRCOPILOTLAB_BP_BIN.
TOOL="$HOME/.dotnet/tools/xrcopilotlab-bp"

if [ -x "$TOOL" ]; then
  # Due accortezze: l'output non va a un terminale, quindi la CLI non colora e il numero si legge
  # pulito; e una CLI che non conosce «version» esce con 1, che con `set -e` ucciderebbe in
  # silenzio proprio l'avviatore — da qui il `|| true`, che è il caso normale, non un'eccezione.
  TOOL_VERSION="$({ "$TOOL" version 2>/dev/null || true; } | awk '/^xrcopilotlab-bp [0-9]/ { print $2; exit }' || true)"

  if [ -n "$TOOL_VERSION" ] && aggiornato "$TOOL_VERSION" "$VERSION"; then
    exec "$TOOL" "$@"
  fi

  echo "xrcopilotlab-bp: ignoro lo strumento globale (${TOOL_VERSION:-più vecchio di 'version'}), il plugin chiede la $VERSION. Per imporlo: XRCOPILOTLAB_BP_BIN=$TOOL" >&2
fi

# 3. La copia già scaricata.
case "$(uname -s)" in
  Darwin)
    if [ "$(uname -m)" = "arm64" ]; then RID="osx-arm64"; else RID="osx-x64"; fi
    ;;
  Linux)
    case "$(uname -m)" in
      aarch64|arm64) RID="linux-arm64" ;;
      *)             RID="linux-x64" ;;
    esac
    ;;
  *)
    die "sistema operativo non riconosciuto: $(uname -s). Su Windows si usa xrcopilotlab-bp.cmd."
    ;;
esac

# Dice, una riga sola, se il plugin è indietro rispetto all'ultima CLI pubblicata.
#
# Chi usa il plugin non lancerà mai un comando per chiederlo: scopre di essere indietro quando un
# comando «non esiste», mesi dopo. Ma il controllo non deve costare niente e non deve poter far
# fallire un comando, quindi: si **legge** la cache (immediato) e si **aggiorna** in background. La
# notizia arriva quindi al comando successivo, il che va benissimo per una cosa che cambia ogni
# poche settimane, e non aggiunge un millisecondo né un modo nuovo di rompersi.
avviso_aggiornamento() {
  M="$(messaggio_aggiornamento)"
  [ -n "$M" ] && echo "xrcopilotlab-bp: $M" >&2

  # Durante un comando le note si aggiornano staccate e mute: il comando non aspetta GitHub.
  if command -v gh >/dev/null 2>&1 && note_scadute; then
    ( aggiorna_note ) >/dev/null 2>&1 &
  fi
}

avviso_aggiornamento

BIN="$CACHE_DIR/xrcopilotlab-bp-$VERSION-$RID"
if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi

ASSET="xrcopilotlab-bp-$RID"
TAG="bp-v$VERSION"

istruzioni_accesso() {
  echo "xrcopilotlab-bp: non sono riuscito a scaricare $ASSET (release $TAG)." >&2
  echo "" >&2
  echo "  Le cause sono tre, e il rimedio è diverso:" >&2
  echo "  · non sei autenticato su GitHub  → 'gh auth login', oppure esporta GH_TOKEN;" >&2
  echo "  · lo sei, ma quell'account non legge $REPO_CATALOGO" >&2
  echo "    → chiedi l'accesso a chi mantiene il catalogo: riprovare non serve;" >&2
  echo "  · la release non ha l'allegato per questa piattaforma ($RID)" >&2
  echo "    → fatti passare il binario e indicalo con:" >&2
  echo "        export XRCOPILOTLAB_BP_BIN=/percorso/del/binario" >&2
  exit 70
}

da_gh() {
  # repository = $1, nome dell'allegato = $2, destinazione = $3
  command -v gh >/dev/null 2>&1 || return 1
  gh auth status >/dev/null 2>&1 || return 1
  gh release download "$TAG" --repo "$1" --pattern "$2" --output "$3" --clobber >/dev/null 2>&1
}

da_token() {
  # repository = $1, nome dell'allegato = $2, destinazione = $3
  TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  [ -n "$TOKEN" ] || return 1

  # Il nome dell'allegato si passa come argomento a python3, non come variabile d'ambiente:
  # in una pipeline la variabile in testa vale per il primo comando, non per quello a valle.
  ASSET_ID="$(curl -fsSL \
      -H "Authorization: Bearer $TOKEN" \
      "https://api.github.com/repos/$1/releases/tags/$TAG" 2>/dev/null \
    | python3 -c 'import json,sys; a=[x["id"] for x in json.load(sys.stdin).get("assets",[]) if x["name"]==sys.argv[1]]; print(a[0] if a else "")' "$2" 2>/dev/null)"

  [ -n "$ASSET_ID" ] || return 1

  curl -fsSL -H "Authorization: Bearer $TOKEN" -H "Accept: application/octet-stream" \
    "https://api.github.com/repos/$1/releases/assets/$ASSET_ID" -o "$3" 2>/dev/null
}

scarica() {
  # nome dell'allegato = $1, file di destinazione = $2. Zero se ce l'ha fatta, da qualunque strada.
  for repo in "$REPO_CATALOGO" "$REPO_PRODOTTO"; do
    da_gh "$repo" "$1" "$2" && return 0
    da_token "$repo" "$1" "$2" && return 0
  done

  return 1
}

# 4. Scaricare. Succede una volta per versione, e lo si annuncia: cinquanta megabyte che arrivano
#    in silenzio sembrano un comando bloccato.
echo "Prima esecuzione: scarico la CLI ($ASSET, ~52 MB) dalla release $TAG." >&2

mkdir -p "$CACHE_DIR"
TMP="$(mktemp "$CACHE_DIR/.download.XXXXXX")"
trap 'rm -f "$TMP" "$TMP.sha256"' EXIT

scarica "$ASSET" "$TMP" || istruzioni_accesso

# Verifica dell'impronta: si sta per eseguire ciò che si è appena scaricato.
if scarica "$ASSET.sha256" "$TMP.sha256" && [ -s "$TMP.sha256" ]; then
  ATTESA="$(awk '{print $1}' "$TMP.sha256" | tr -d '\r')"
  OTTENUTA="$(shasum -a 256 "$TMP" | awk '{print $1}')"
  if [ "$ATTESA" != "$OTTENUTA" ]; then
    die "impronta non corrispondente (attesa $ATTESA, ottenuta $OTTENUTA). Non eseguo il file."
  fi
else
  echo "xrcopilotlab-bp: la release non pubblica l'impronta, download non verificato." >&2
fi

chmod +x "$TMP"
mv "$TMP" "$BIN"
rm -f "$TMP.sha256"
trap - EXIT

echo "CLI pronta in $BIN" >&2
exec "$BIN" "$@"
